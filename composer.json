{
    "name": "notakey/simplesamlphp-module-consul",
    "description": "A SimpleSAMLphp module adding support for Consul KV.",
    "type": "simplesamlphp-module",
    "keywords": ["notakey", "consul"],
    "license": "GPL-3.0",
    "authors": [{
        "name": "Ingemars Asmanis",
        "email": "ingemars.asmanis@notakey.com"
    }],
    "autoload": {
        "psr-4": {
            "SimpleSAML\\Module\\consul\\": "src/"
        }
    },
    "require": {
        "php": "^8.3",
        "simplesamlphp/composer-module-installer": "^1.7",
        "simplesamlphp/simplesamlphp": "^2.5",
        "friendsofphp/consul-php-sdk": "^5.4"
    },
    "config": {
        "allow-plugins": {
            "simplesamlphp/composer-module-installer": true
        }
    }
}
